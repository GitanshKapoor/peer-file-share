# ============================================================
# PFS — Local environment variables for Docker Compose
# Copy this file and fill in your values:
#   cp .env.example .env
# .env is gitignored — never commit it.
# ============================================================
# Storage Account Configuration
AZURE_STORAGE_ACCOUNT_NAME=pfsstoragei4s26a
AZURE_STORAGE_ACCOUNT_KEY=your_base64_account_key_here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=pfs-uploads

# Optional — leave empty for local dev (uses Azurite emulator for function state)
AZURE_WEBJOBS_STORAGE=
